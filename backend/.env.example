PORT=4000

# ── Required. The service REFUSES TO START without these. ──
# It used to boot happily with them unset and serve the entire attendance
# registry unauthenticated, so missing credentials are now a hard startup error.

# Device auth — must match the app's SYNC_API_KEY / frontend VITE_SYNC_KEY.
API_KEY=CHANGE_ME
# Admin dashboard login (POST /api/admin/login). Independent of API_KEY, so the
# key baked into the app binary does not grant admin access.
ADMIN_USER=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME

# ── Optional ──
# Server-rendered ops console (/admin?key=...). Without it that page is denied.
ADMIN_PASSCODE=CHANGE_ME
# Allowed browser origin (your Vercel URL in production). Defaults to '*'.
CORS_ORIGIN=http://localhost:5173
# Postgres (RDS / Render). Empty = in-memory store, lost on restart.
DATABASE_URL=
# Supabase as the durable store (service_role key — server-side only).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Local development only ──
# Runs the service with NO authentication at all. Never set this on a deployed
# instance; it exists so a local demo can skip credential setup deliberately
# rather than by accident.
# ALLOW_INSECURE_NO_AUTH=1
