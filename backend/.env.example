PORT=4000
# Sync auth — must match the frontend VITE_SYNC_KEY.
API_KEY=CHANGE_ME
# Operations console (/admin?key=...) passcode.
ADMIN_PASSCODE=CHANGE_ME
# Allowed browser origin (your Vercel URL in production).
CORS_ORIGIN=http://localhost:5173
# Optional Postgres (RDS / Render). Empty = in-memory store.
DATABASE_URL=
# Optional external AI service key, server-side only (never sent to the browser).
SERVICE_API_KEY=
