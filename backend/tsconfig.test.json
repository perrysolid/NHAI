{
  // Type-checks the whole source tree INCLUDING tests, without emitting.
  // The build config (tsconfig.json) deliberately excludes tests so they cannot
  // end up in dist/; this brings them back under the type checker.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": []
}
